{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "game-play-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "ROOM_DIRECTORY",
        "class_name": "RoomDirectory"
      },
      {
        "name": "MINESWEEPER_LEADERBOARD",
        "class_name": "MinesweeperLeaderboard"
      },
      {
        "name": "GAME_2048_LEADERBOARD",
        "class_name": "Game2048Leaderboard"
      },
      {
        "name": "SNAKE_LEADERBOARD",
        "class_name": "SnakeLeaderboard"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "RoomDirectory": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MinesweeperLeaderboard": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Game2048Leaderboard": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "SnakeLeaderboard": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "routes": [
    {
      "pattern": "play.ym0v0.com",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": ["SESSION_SECRET"]
  },
  "observability": {
    "enabled": true
  }
}
