{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "game-play-web-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "ROOM_DIRECTORY",
        "class_name": "RoomDirectory"
      },
      {
        "name": "MINESWEEPER_LEADERBOARD",
        "class_name": "MinesweeperLeaderboard"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "RoomDirectory": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MinesweeperLeaderboard": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "SESSION_SECRET": "integration-test-secret-with-enough-entropy"
  }
}
